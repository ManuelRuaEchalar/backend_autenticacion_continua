{
  "schema_version": 1,
  "model_file": "auth_fedper.tflite",
  "architecture": "FedPer/SharedEncoder+PersonalHead",
  "source_notebook": "mejor.py",
  "signal": {
    "window_size": 128,
    "n_features": 6,
    "target_hz": 50,
    "window_step": 96,
    "sensor_config": "acc_gyro",
    "channel_order": [
      "acc_x",
      "acc_y",
      "acc_z",
      "gyro_x",
      "gyro_y",
      "gyro_z"
    ]
  },
  "weights": {
    "encoder_flat_size": 25464,
    "head_flat_size": 14359,
    "encoder_num_tensors": 15,
    "head_num_tensors": 11,
    "federated_block": "encoder",
    "local_only_block": "head"
  },
  "training": {
    "local_epochs": 5,
    "batch_size": 32,
    "train_genuine_per_batch": 16,
    "train_background_per_batch": 16,
    "learning_rate": 0.001,
    "lr_decay_factor": 0.5,
    "lr_decay_at": 0.7,
    "cls_loss_weight": 2.0,
    "background_ratio": 1.0,
    "reset_optimizer_each_round": true
  },
  "evaluation": {
    "infer_batch": 32,
    "decision_threshold": 0.5,
    "test_ratio": 0.2,
    "val_ratio": 0.2,
    "model_selection_metric": "val_auc"
  },
  "assets": {
    "scaler_stats": "scaler_stats.json",
    "scaler_is_identity_placeholder": false,
    "background_train": "background_train.bin",
    "background_train_windows": 600,
    "background_calib": "background_calib.bin",
    "background_calib_windows": 400
  },
  "signatures": {
    "initialize": {
      "inputs": [
        "dummy"
      ],
      "outputs": [
        "status"
      ]
    },
    "train_step": {
      "inputs": [
        "x_genuine",
        "x_background"
      ],
      "outputs": [
        "loss",
        "recon_loss",
        "cls_loss"
      ]
    },
    "infer": {
      "inputs": [
        "x",
        "threshold"
      ],
      "outputs": [
        "genuine_score",
        "reconstruction_error",
        "is_genuine"
      ]
    },
    "infer_batch": {
      "inputs": [
        "x",
        "threshold"
      ],
      "outputs": [
        "genuine_score",
        "reconstruction_error",
        "is_genuine"
      ]
    },
    "save_encoder": {
      "inputs": [
        "dummy"
      ],
      "outputs": [
        "encoder_flat"
      ]
    },
    "restore_encoder": {
      "inputs": [
        "encoder_flat"
      ],
      "outputs": [
        "status"
      ]
    },
    "save_head": {
      "inputs": [
        "dummy"
      ],
      "outputs": [
        "head_flat"
      ]
    },
    "restore_head": {
      "inputs": [
        "head_flat"
      ],
      "outputs": [
        "status"
      ]
    },
    "set_lr": {
      "inputs": [
        "lr"
      ],
      "outputs": [
        "lr"
      ]
    },
    "reset_optimizer": {
      "inputs": [
        "dummy"
      ],
      "outputs": [
        "status"
      ]
    }
  }
}